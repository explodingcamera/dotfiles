{
	"share": "disabled",
	"lsp": true,
	"permissions": [
		{ "action": "skill", "resource": "*", "effect": "deny" },
		{ "action": "todowrite", "resource": "*", "effect": "allow" },
		{ "action": "external_directory", "resource": "~/.local/share/cargo/**", "effect": "allow" },
		{ "action": "external_directory", "resource": "/tmp/opencode", "effect": "allow" },
		{ "action": "edit", "resource": "~/.local/share/cargo/**", "effect": "deny" },
		{ "action": "shell", "resource": "*", "effect": "ask" },
		{ "action": "shell", "resource": "rm *", "effect": "deny" },
		{ "action": "shell", "resource": "grep *", "effect": "allow" },
		{ "action": "shell", "resource": "tee *", "effect": "allow" },
		{ "action": "shell", "resource": "cat *", "effect": "allow" },
		{ "action": "shell", "resource": "zizmor *", "effect": "allow" },
		{ "action": "shell", "resource": "shellcheck *", "effect": "allow" },
		{ "action": "shell", "resource": "pinact *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo run *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo test *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo check *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo fmt *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo build *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo bench *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo tree *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo samply *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo expand *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo dev *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo add *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo migrate *", "effect": "allow" },
		{ "action": "shell", "resource": "cargo run --example *", "effect": "allow" },
		{ "action": "shell", "resource": "head *", "effect": "allow" },
		{ "action": "shell", "resource": "gh pr view *", "effect": "allow" },
		{ "action": "shell", "resource": "gh issue view *", "effect": "allow" },
		{ "action": "shell", "resource": "tail *", "effect": "allow" },
		{ "action": "shell", "resource": "ls *", "effect": "allow" },
		{ "action": "shell", "resource": "biome *", "effect": "allow" },
		{ "action": "shell", "resource": "rg *", "effect": "allow" },
		{ "action": "shell", "resource": "tokei *", "effect": "allow" },
		{ "action": "shell", "resource": "wc *", "effect": "allow" },
		{ "action": "shell", "resource": "RUST_BACKTRACE=full cargo *", "effect": "allow" },
		{ "action": "shell", "resource": "RUST_LOG=trace cargo *", "effect": "allow" },
		{ "action": "shell", "resource": "bun run *", "effect": "allow" },
		{ "action": "shell", "resource": "git status *", "effect": "allow" },
		{ "action": "shell", "resource": "git diff *", "effect": "allow" },
		{ "action": "shell", "resource": "git log *", "effect": "allow" },
		{ "action": "shell", "resource": "git blame *", "effect": "allow" },
		{ "action": "shell", "resource": "git show *", "effect": "allow" },
		{ "action": "shell", "resource": "git remote -v", "effect": "allow" },
		{ "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
		{ "action": "shell", "resource": "git rev-parse --abrev-ref HEAD", "effect": "allow" },
		{ "action": "shell", "resource": "git ls-files *", "effect": "allow" }
	]
}
