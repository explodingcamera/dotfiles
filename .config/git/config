[commit]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true
[core]
	editor = code --wait
[tag]
	gpgSign = true
[advice]
	detachedHead = false
[credential]
	helper =
	helper = /usr/sbin/git-credential-manager
	credentialStore = secretservice

